pkgname=clips
pkgver=0.1.0
pkgrel=1
pkgdesc='Browse the Omarchy clipboard history and copy an entry back'
arch=('x86_64' 'aarch64')
license=('MIT')
depends=('qt6-base' 'qt6-declarative' 'qt6-wayland' 'wl-clipboard')
makedepends=('gcc' 'make')
optdepends=('omarchy: open text and image entries with Omarchy tools')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  install -Dm755 build/clips "$pkgdir/usr/bin/clips"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 "$startdir/clips.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/clips.svg"
  install -Dm644 "$startdir/clips.desktop" "$pkgdir/usr/share/applications/clips.desktop"
}
